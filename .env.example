# Copy to .env (never commit .env) and set a password.

# docker-compose postgres
POSTGRES_USER=latih
POSTGRES_PASSWORD=
POSTGRES_DB=latih

# API: compose builds DATABASE_URL from the values above. For `go run ./cmd/api`
# set it yourself, e.g. postgres://latih:<password>@localhost:5433/latih?sslmode=disable
# (Neon needs sslmode=require). PORT defaults to 8080.
# DATABASE_URL=
# PORT=8080

# Browser origin allowed to call the API directly (empty = no CORS headers).
CORS_ORIGIN=http://localhost:5173

# Host port of the web container (nginx), reachable from the LAN.
WEB_PORT=8081
